{
  "extends": "astro/tsconfigs/strict",
  // O protótipo e o bundle do design system ficam de fora: são registro histórico,
  // não código que a gente mantém.
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "astro.config.mjs"],
  "exclude": ["dist", "node_modules", "_ds", "public/_ds", "support.js", "corpus.js"]
}
