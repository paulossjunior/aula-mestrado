---
import { rota } from "../lib/url";
import dados from "../content/multica.json";

// O guia de leitura: os quatro modos do Diátaxis na ordem em que se lê pela
// primeira vez — entender, conhecer os conceitos, fazer, e só depois as receitas.
// `fim` troca o mapa completo pelo convite à próxima etapa, no pé da página.
interface Props {
  atual: string;
  fim?: boolean;
}
const { atual, fim = false } = Astro.props;

// Fora das páginas do Multica (na aula, por exemplo) nenhuma etapa é a atual.
const i = dados.modos.findIndex((m) => m.href === atual);
const proxima = dados.modos[i + 1];
const situacao =
  i < 0
    ? "comece pela etapa 1"
    : /^\d+$/.test(dados.modos[i].etapa)
      ? `etapa ${dados.modos[i].etapa} de ${dados.modos.length - 1}`
      : `depois das ${dados.modos.length - 1} etapas`;
---

{
  !fim && (
    <section style="border-top: 2px solid var(--color-text)">
      <nav aria-label="Guia de leitura do Multica" class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 24px 32px 0">
        <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6">
          Guia de leitura · {situacao}
        </div>
        <ol style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr))">
          {dados.modos.map((m) => {
            const aqui = m.href === atual;
            return (
              <li>
                <a
                  class="om-hover"
                  href={rota(m.href)}
                  aria-current={aqui ? "page" : undefined}
                  style={`display: block; height: 100%; padding: 16px 20px 22px 0; color: var(--color-text); border-bottom: 4px solid ${aqui ? "var(--color-accent)" : "transparent"}`}
                >
                  <div style="display: flex; gap: 10px; align-items: baseline">
                    <span style="font-family: var(--font-heading); font-weight: 900; font-size: 26px; line-height: 1; color: var(--color-accent)">
                      {m.etapa}
                    </span>
                    <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700)">
                      {m.verbo} · {m.modo}
                    </span>
                  </div>
                  <div style="font-family: var(--font-heading); font-weight: 800; font-size: 17px; line-height: 1.2; margin-top: 8px">
                    {m.titulo}
                  </div>
                  <div style="font-size: 14px; line-height: 1.45; margin-top: 6px; opacity: 0.75">{m.para}</div>
                  <div style="font-size: 12px; font-weight: 700; margin-top: 8px; opacity: 0.6">{m.tempo}</div>
                </a>
              </li>
            );
          })}
        </ol>
      </nav>
    </section>
  )
}

{
  fim && proxima && (
    <section style="border-top: 2px solid var(--color-text)">
      <div class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 0 32px">
        <a class="om-hover" href={rota(proxima.href)} style="display: block; padding: 28px 0; color: var(--color-text)">
          <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6">
            Próximo no guia de leitura →
          </div>
          <div style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(20px, 3vw, 26px); margin-top: 8px; line-height: 1.2">
            {proxima.etapa} · {proxima.verbo}: {proxima.titulo}
          </div>
          <div style="font-size: 14px; line-height: 1.45; margin-top: 6px; opacity: 0.75; max-width: 66ch">{proxima.para}</div>
        </a>
      </div>
    </section>
  )
}
