---
import Migalha from "../components/Migalha.astro";
import Base from "../layouts/Base.astro";
import { rota } from "../lib/url";
import dados from "../content/formulario-arguicao.json";
---

<Base
  titulo="Formulário de arguição entre pares — Dev. de Software com IA"
  descricao="Os cinco campos que estruturam a arguição nos encontros de apresentação: o que capturar durante a fala do colega e como usar o formulário nos 8 minutos de debate."
>
  <article>
    <section class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 36px 32px 0">
      <Migalha trilha={[{ texto: "Início", href: "/" }, { texto: "Aula 07", href: "/aulas/07" }, { texto: "Formulário de arguição" }]} />
      <div
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700); margin-top: 28px"
      >
        Referência · Encontros de apresentação e debate
      </div>
      <h1
        style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(34px, 6vw, 64px); line-height: 0.98; letter-spacing: -0.035em; margin: 14px 0 0; max-width: 20ch; text-wrap: balance"
      >
        Formulário de arguição entre pares
      </h1>
      <p style="font-size: 17px; line-height: 1.65; max-width: 64ch; margin: 24px 0 0; text-wrap: pretty">
        {dados.situacao}
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 40px">
        <a class="btn btn-primary" href={rota("/roteiro-apresentacao")}>O roteiro das 8 telas</a>
        <a class="btn btn-secondary" href={rota("/avaliacao")}>Como é avaliado</a>
      </div>
    </section>

    <section style="border-top: 2px solid var(--color-text)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(24px, 4vw, 36px); letter-spacing: -0.025em; margin: 0 0 24px">
          Os cinco campos
        </h2>
        <div style="border-top: 2px solid var(--color-text)">
          {
            dados.campos.map((c, i) => (
              <div
                class="om-aula-grid"
                style="display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 12px 32px; padding: 22px 0; border-bottom: 2px solid var(--color-divider); align-items: start"
              >
                <div>
                  <div style="font-family: var(--font-heading); font-weight: 900; font-size: 30px; letter-spacing: -0.03em; color: var(--color-accent); opacity: 0.5; line-height: 1">
                    {String(i + 1).padStart(2, "0")}
                  </div>
                  <h3 style="font-family: var(--font-heading); font-weight: 900; font-size: 19px; line-height: 1.2; letter-spacing: -0.02em; margin: 8px 0 0">
                    {c.nome}
                  </h3>
                  <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.55; margin-top: 6px">
                    {c.tipo}
                  </div>
                </div>
                <p style="font-size: 16px; line-height: 1.65; margin: 0; max-width: 66ch; text-wrap: pretty">
                  {c.instrucao}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(22px, 3.5vw, 32px); letter-spacing: -0.025em; margin: 0 0 16px">
          Como usar
        </h2>
        <ul style="margin: 0; padding: 0; list-style: none; max-width: 74ch">
          {
            dados.uso.map((u) => (
              <li style="display: flex; gap: 12px; align-items: baseline; padding: 10px 0; border-bottom: 2px solid var(--color-divider); font-size: 16px; line-height: 1.55">
                <span style="font-family: var(--font-heading); font-weight: 900; color: var(--color-accent)" aria-hidden="true">
                  →
                </span>
                <span style="text-wrap: pretty">{u}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </article>
</Base>
