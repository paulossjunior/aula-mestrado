---
import Base from "../layouts/Base.astro";
import { rota } from "../lib/url";
import { todasAulas, NOMES_U, estiloTag } from "../lib/aulas";
import fases from "../content/codebook/fases.json";
import bibliografia from "../content/bibliografia.json";
import avaliacao from "../content/avaliacao.json";
import curso from "../content/curso.json";
import { SECUNDARIOS } from "../data/corpus.js";

const aulas = await todasAulas();

// Bibliografia: os ids curados casados com o registro do corpus.
const porId = new Map(SECUNDARIOS.map((r: any) => [r.id, r]));
const artigos = bibliografia
  .map(({ id, tag }) => {
    const r: any = porId.get(id);
    if (!r) return null;
    return {
      titulo: r.t,
      autor: r.na && Number(r.na) > 1 ? `${r.a} et al. (${r.na} autores)` : r.a,
      fase: r.f,
      faseNome: r.fn,
      fonte: `${r.tpn} · arXiv:${id}`,
      tag,
      cit: r.cit ? `${r.cit} ${r.cit === "1" ? "citação" : "citações"}` : "Sem citações indexadas",
      href: `https://arxiv.org/abs/${id}`,
    };
  })
  .filter(Boolean) as any[];


const fatos = [
  { rotulo: "Programa", valor: "PPCOMP · Mestrado" },
  { rotulo: "Carga horária", valor: "45h" },
  { rotulo: "Encontros", valor: "Qui · 19h20–22h" },
  { rotulo: "Local", valor: "Câmpus Serra · Lab. de Software" },
];

const filtros = [
  { chave: "Todas", label: "Tudo" },
  { chave: "I", label: NOMES_U.I },
  { chave: "II", label: NOMES_U.II },
  { chave: "III", label: NOMES_U.III },
];

const estiloFiltro = (i: number, ativo: boolean) =>
  [
    "font-family: var(--font-heading)",
    "font-weight: 700",
    "font-size: 13px",
    "letter-spacing: 0.06em",
    "text-transform: uppercase",
    "padding: 10px 18px",
    "border: 0",
    "cursor: pointer",
    i > 0 ? "border-left: 2px solid var(--color-text)" : "",
    ativo
      ? "background: var(--color-text); color: var(--color-bg)"
      : "background: transparent; color: var(--color-text)",
  ]
    .filter(Boolean)
    .join("; ");
---

<Base
  titulo="Desenvolvimento de Software Suportado por IA — PPCOMP/IFES Serra 2026.2"
  descricao="Disciplina do Mestrado em Computação Aplicada do IFES Serra sobre modelos de linguagem e agentes autônomos no ciclo de vida do software, com avaliação empírica."
>
  <section id="topo" class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px 0">
    <div
      style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700)"
    >
      Tópico Especial em Inteligência Artificial · Mestrado em Computação Aplicada · IFES Serra ·
      2026.2
    </div>
    {/* mínimo em 36px e hífen automático: "Desenvolvimento" a 44px estoura 375px de tela */}
    <h1
      style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(36px, 7vw, 92px); line-height: 0.94; letter-spacing: -0.035em; margin: 20px 0 0; max-width: 17ch; text-wrap: balance; hyphens: auto"
    >
      Desenvolvimento de Software Suportado por IA
    </h1>
    <p style="font-size: 20px; line-height: 1.5; max-width: 60ch; margin: 28px 0 40px; text-wrap: pretty">
      Como modelos de linguagem e agentes autônomos estão reescrevendo o ciclo de vida do software —
      e como avaliar isso com rigor empírico. Um semestre entre leitura de artigos, experimentação
      com ferramentas e um estudo próprio publicável.
    </p>
    <div style="display: flex; gap: 12px; flex-wrap: wrap; padding-bottom: 48px">
      <a class="btn btn-primary" href="#cronograma">Ver cronograma</a>
      <a class="btn btn-secondary" href="#leituras">Bibliografia</a>
    </div>
  </section>

  <section style="border-top: 2px solid var(--color-text); border-bottom: 2px solid var(--color-text)">
    <div
      class="om-pad"
      style="max-width: 1200px; margin: 0 auto; padding: 0 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr))"
    >
      {
        fatos.map((f, i) => (
          <div
            style={`padding: 24px ${i === fatos.length - 1 ? "0" : "24px"} 24px ${i === 0 ? "0" : "24px"}; ${i === fatos.length - 1 ? "" : "border-right: 2px solid var(--color-divider)"}`}
          >
            <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6">
              {f.rotulo}
            </div>
            <div style="font-family: var(--font-heading); font-weight: 800; font-size: 26px; margin-top: 6px">
              {f.valor}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="ementa" class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px">
    <div
      class="om-2col"
      style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 64px; align-items: start"
    >
      <div>
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: 34px; letter-spacing: -0.02em; margin: 0 0 20px">
          Ementa
        </h2>
        {
          curso.ementa.map((p, i) => (
            <p
              style={`font-size: 17px; line-height: 1.65; margin: 0 0 ${i === curso.ementa.length - 1 ? "0" : "16px"}; text-wrap: pretty`}
              set:html={p}
            />
          ))
        }
      </div>
      <div>
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: 34px; letter-spacing: -0.02em; margin: 0 0 20px">
          Ao final, você deve
        </h2>
        <ol style="margin: 0; padding: 0; list-style: none; display: grid; gap: 0">
          {
            curso.objetivos.map((o, i) => (
              <li
                style={`display: grid; grid-template-columns: 40px 1fr; gap: 16px; padding: 16px 0; border-top: 2px solid var(--color-divider); ${i === curso.objetivos.length - 1 ? "border-bottom: 2px solid var(--color-divider);" : ""} font-size: 16px; line-height: 1.5`}
              >
                <span style="font-family: var(--font-heading); font-weight: 800; color: var(--color-accent)">
                  {String(i + 1).padStart(2, "0")}
                </span>
                <span set:html={o} />
              </li>
            ))
          }
        </ol>
        <p
          style="font-size: 16px; line-height: 1.6; margin: 18px 0 0; padding-left: 16px; box-shadow: inset 2px 0 0 var(--color-accent); text-wrap: pretty"
          set:html={curso.notaObjetivos}
        />
      </div>
    </div>
  </section>

  <section id="fases-teaser" style="border-top: 2px solid var(--color-text)">
    <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px">
      <div
        class="om-2col"
        style="display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 64px; align-items: start"
      >
        <div>
          <div
            style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700)"
          >
            Material da Aula 01 · Codebook
          </div>
          <h2
            style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(30px, 4vw, 46px); line-height: 1.02; letter-spacing: -0.025em; margin: 10px 0 0; max-width: 24ch; text-wrap: balance"
          >
            As doze fases do processo de software
          </h2>
          <p style="font-size: 17px; line-height: 1.65; max-width: 60ch; margin: 20px 0 0; text-wrap: pretty">
            O mapa que organiza a disciplina: onze códigos que classificam a literatura de engenharia
            de software com IA, com escopo, teste de decisão e as contagens dos dois corpora: 236
            estudos secundários e 338 artigos em sedes revisadas por pares.
          </p>
          <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 28px">
            <a class="btn btn-primary" href={rota("/codebook")}>Abrir o codebook</a>
            <a class="btn btn-secondary" href={rota("/codebook/mapeamento")}>Ver o mapeamento</a>
          </div>
        </div>
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 2px; background: var(--color-divider); border: 2px solid var(--color-text)"
        >
          {
            fases.map((f) => (
              <a
                class="om-hover"
                href={rota("/codebook")}
                style="background: var(--color-bg); padding: 16px; display: block; color: var(--color-text)"
              >
                <div style="font-family: var(--font-heading); font-weight: 900; font-size: 17px; line-height: 1.15; letter-spacing: -0.02em; color: var(--color-accent)">
                  {f.curto}
                </div>
                <div style="font-size: 13px; line-height: 1.3; margin-top: 6px; opacity: 0.75">
                  {f.nome}
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section id="cronograma" style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
    <div class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px">
      <div
        style="display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 28px"
      >
        <div>
          <div
            style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700)"
          >
            17 encontros · quintas, 6 ago a 3 dez
          </div>
          <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(34px, 4vw, 52px); letter-spacing: -0.025em; margin: 10px 0 0">
            Cronograma
          </h2>
        </div>
        <div class="om-filter" id="filtro-unidade" style="display: flex; gap: 0; border: 2px solid var(--color-text)">
          {
            filtros.map((f, i) => (
              <button
                type="button"
                data-unidade={f.chave}
                data-i={i}
                style={estiloFiltro(i, f.chave === "Todas")}
              >
                {f.label}
              </button>
            ))
          }
        </div>
      </div>

      <div style="border-top: 2px solid var(--color-text)">
        {
          aulas.map((a) => (
            <>
              {a.n === "06" && (
                <div
                  class="om-row linha-recesso"
                  data-unidade="Todas"
                  style="display: grid; grid-template-columns: 78px 96px minmax(0, 1fr) 150px 28px; gap: 20px; align-items: baseline; padding: 18px 12px 18px 0; border-bottom: 2px solid var(--color-divider); background: repeating-linear-gradient(135deg, transparent, transparent 8px, var(--color-neutral-200) 8px, var(--color-neutral-200) 9px)"
                >
                  <div class="om-row-num" style="font-family: var(--font-heading); font-weight: 900; font-size: 22px; letter-spacing: -0.02em; opacity: 0.4">
                    —
                  </div>
                  <div class="om-row-data" style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.65">
                    10 set
                  </div>
                  <div class="om-row-title">
                    <div style="font-family: var(--font-heading); font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em; opacity: 0.7">
                      Sem aula — SBES 2026
                    </div>
                    <div style="font-size: 14px; margin-top: 5px; opacity: 0.6">
                      O professor estará no Simpósio Brasileiro de Engenharia de Software.
                    </div>
                  </div>
                  <div class="om-row-unit" style="font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.5">
                    Recesso
                  </div>
                  <div class="om-row-sign" />
                </div>
              )}
              <a
                class="om-hover linha-aula"
                data-unidade={a.unidade}
                href={rota(`/aulas/${a.n}`)}
                style="display: block; color: var(--color-text); border-bottom: 2px solid var(--color-divider); transition: background 120ms"
              >
                <div
                  class="om-row"
                  style="display: grid; grid-template-columns: 78px 96px minmax(0, 1fr) 150px 28px; gap: 20px; align-items: baseline; padding: 18px 12px 18px 0"
                >
                  <div class="om-row-num" style="font-family: var(--font-heading); font-weight: 900; font-size: 22px; letter-spacing: -0.02em">
                    {a.n}
                  </div>
                  <div class="om-row-data" style="font-size: 13px; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; opacity: 0.65">
                    {a.data}
                  </div>
                  <div class="om-row-title">
                    <div
                      style={`font-family: var(--font-heading); font-weight: 700; font-size: 19px; line-height: 1.25; letter-spacing: -0.01em${a.aDefinir ? "; opacity: 0.55" : ""}`}
                    >
                      {a.titulo}
                    </div>
                    <div style="font-size: 14px; margin-top: 5px; opacity: 0.7">{a.leitura}</div>
                  </div>
                  <div class="om-row-unit" style="font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-accent-700)">
                    {a.estado === "apresentacao" ? "Apresentação" : NOMES_U[a.unidade]}
                  </div>
                  <div class="om-row-sign" style="font-family: var(--font-heading); font-weight: 800; font-size: 18px; text-align: right; color: var(--color-accent)">
                    →
                  </div>
                </div>
              </a>
            </>
          ))
        }
      </div>
      <p style="font-size: 14px; opacity: 0.6; margin: 18px 0 0">
        Cada encontro tem página própria. Por ora só o primeiro está fechado; o último encontro de
        cada mês é sempre apresentação de trabalho e debate.
      </p>
    </div>
  </section>

  <section id="leituras" style="border-top: 2px solid var(--color-text)">
    <div class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px">
      <div
        style="display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-bottom: 32px"
      >
        <div>
          <div
            style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700)"
          >
            Bibliografia
          </div>
          <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(34px, 4vw, 52px); letter-spacing: -0.025em; margin: 10px 0 0">
            Artigos
          </h2>
        </div>
        <div>
          <p style="font-size: 15px; max-width: 44ch; margin: 0; opacity: 0.75">
            Todos vêm do corpus mapeado na Aula 01. Em vermelho, o núcleo já consolidado por citação;
            em contorno, a fronteira <em>Agentic</em> de 2025–2026. Todos no arXiv, de acesso aberto.
          </p>
          <a
            href={rota("/leituras")}
            style="display: inline-block; margin-top: 12px; font-family: var(--font-heading); font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase"
            >Base de leituras por fase →</a
          >
        </div>
      </div>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 2px; background: var(--color-divider); border: 2px solid var(--color-text)"
      >
        {
          artigos.map((t) => (
            <article style="background: var(--color-bg); padding: 24px; display: flex; flex-direction: column; gap: 10px; min-height: 210px">
              <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap">
                <span style={estiloTag(t.tag)}>{t.tag}</span>
                <span style="font-family: var(--font-heading); font-weight: 800; font-size: 13px; letter-spacing: 0.06em; color: var(--color-accent)">
                  {t.faseNome}
                </span>
              </div>
              <a
                href={t.href}
                target="_blank"
                rel="noopener"
                style="font-family: var(--font-heading); font-weight: 800; font-size: 20px; line-height: 1.2; letter-spacing: -0.015em; margin: 4px 0 0; text-wrap: pretty"
              >
                {t.titulo}
              </a>
              <div style="font-size: 15px; opacity: 0.75; line-height: 1.45">
                {t.autor} · {t.cit}
              </div>
              <div style="margin-top: auto; padding-top: 14px; border-top: 2px solid var(--color-divider); font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase">
                {t.fonte}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="avaliacao-resumo" style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
    <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 72px 32px">
      <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(34px, 4vw, 52px); letter-spacing: -0.025em; margin: 0 0 14px">
        Avaliação
      </h2>
      <p style="font-size: 17px; line-height: 1.6; max-width: 60ch; margin: 0 0 28px; text-wrap: pretty">
        Os laboratórios e o artigo final são feitos <strong>sobre o tema da sua pesquisa</strong> —
        não sobre um exercício genérico da disciplina.
      </p>
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2px; background: var(--color-divider); border: 2px solid var(--color-text)"
      >
        {
          avaliacao.pesos.map((p) => (
            <div style="background: var(--color-bg); padding: 28px">
              <div style="font-family: var(--font-heading); font-weight: 900; font-size: 56px; line-height: 1; letter-spacing: -0.04em; color: var(--color-accent)">
                {p.peso}
              </div>
              <div style="font-family: var(--font-heading); font-weight: 800; font-size: 19px; margin-top: 14px">
                {p.titulo}
              </div>
              <p style="font-size: 15px; line-height: 1.55; margin: 8px 0 0; opacity: 0.8">{p.resumo}</p>
            </div>
          ))
        }
      </div>
      <div
        style="margin-top: 28px; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 32px; font-size: 15px; line-height: 1.6"
      >
        <p style="margin: 0">
          <strong style="font-family: var(--font-heading); font-weight: 800">Reprodutibilidade.</strong>
          Toda entrega inclui repositório com <em>seed</em>, versão do modelo e instruções de execução.
        </p>
        <p style="margin: 0">
          <strong style="font-family: var(--font-heading); font-weight: 800">Uso de IA.</strong>
          Encorajado e obrigatoriamente declarado: registre ferramenta, versão e o que foi gerado.
        </p>
        <p style="margin: 0">
          <strong style="font-family: var(--font-heading); font-weight: 800">Atrasos.</strong>
          Desconto de 10% por dia corrido; após cinco dias a entrega não é aceita.
        </p>
      </div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px">
        <a class="btn btn-primary" href={rota("/avaliacao")}>Critérios completos</a>
      </div>
    </div>
  </section>

  <section id="contato" style="border-top: 2px solid var(--color-text); background: var(--color-accent); color: #fff">
    <div class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 80px 32px">
      <div
        style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 48px; align-items: start"
      >
        <div>
          <h2
            style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(38px, 5vw, 68px); line-height: 0.98; letter-spacing: -0.035em; margin: 0; text-wrap: balance"
          >
            A ferramenta muda todo mês. O método, não.
          </h2>
        </div>
        <div style="display: grid; gap: 0; font-size: 17px">
          <div style="padding: 16px 0; border-top: 2px solid rgba(255,255,255,0.45)">
            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8">
              Professor
            </div>
            <div style="font-family: var(--font-heading); font-weight: 800; font-size: 22px; margin-top: 4px">
              Paulo Sérgio dos Santos Júnior
            </div>
          </div>
          <div style="padding: 16px 0; border-top: 2px solid rgba(255,255,255,0.45)">
            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8">
              E-mail
            </div>
            <div style="font-family: var(--font-heading); font-weight: 800; font-size: 22px; margin-top: 4px">
              paulo.junior@ifes.edu.br
            </div>
          </div>
          <div
            style="padding: 16px 0; border-top: 2px solid rgba(255,255,255,0.45); border-bottom: 2px solid rgba(255,255,255,0.45)"
          >
            <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.8">
              Atendimento
            </div>
            <div style="font-family: var(--font-heading); font-weight: 800; font-size: 22px; margin-top: 4px">
              A combinar por e-mail
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Filtro de unidade do cronograma. Sem JS a lista aparece inteira.
  const grupo = document.getElementById("filtro-unidade");
  if (grupo) {
    const botoes = Array.from(grupo.querySelectorAll<HTMLButtonElement>("button"));
    const linhas = Array.from(
      document.querySelectorAll<HTMLElement>(".linha-aula, .linha-recesso")
    );

    const pintar = (ativo: string) => {
      botoes.forEach((b) => {
        const ligado = b.dataset.unidade === ativo;
        b.style.background = ligado ? "var(--color-text)" : "transparent";
        b.style.color = ligado ? "var(--color-bg)" : "var(--color-text)";
      });
    };

    grupo.addEventListener("click", (ev) => {
      const alvo = (ev.target as HTMLElement).closest("button");
      if (!alvo) return;
      const escolha = alvo.dataset.unidade!;
      linhas.forEach((l) => {
        const u = l.dataset.unidade!;
        // O recesso só faz sentido na visão completa. `display` volta ao valor
        // original do elemento — a linha é um <a> em bloco, o recesso é grid.
        const original = l.classList.contains("linha-aula") ? "block" : "grid";
        l.style.display = escolha === "Todas" || u === escolha ? original : "none";
      });
      pintar(escolha);
    });
  }
</script>
