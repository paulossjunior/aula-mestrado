---
import Base from "../layouts/Base.astro";
import { rota } from "../lib/url";
import dados from "../content/leituras-base.json";
import nomesFase from "../content/nomes-fase.json";

// A métrica de cada obra vira uma linha só: citações · FWCI · momentum.
const abasCorpus = [
  { chave: "sec", label: "157 estudos secundários" },
  { chave: "sedes", label: "106 artigos em sedes" },
];

// O corpus guarda a fase como código; o botão mostra o nome.
// Só F1–F8 porque este recorte é anterior à revisão que criou as três novas fases.
const fasesCorpus = [
  { chave: "Todas", label: "Todas" },
  { chave: "F1", label: nomesFase.F1 },
  { chave: "F2", label: nomesFase.F2 },
  { chave: "F3", label: nomesFase.F3 },
  { chave: "F4", label: nomesFase.F4 },
  { chave: "F5", label: nomesFase.F5 },
  { chave: "F6", label: nomesFase.F6 },
  { chave: "F7", label: nomesFase.F7 },
  { chave: "F8", label: nomesFase.F8 },
];

const estiloBotao = (ativo: boolean) =>
  [
    "font-family: var(--font-heading)",
    "font-weight: 700",
    "font-size: 12px",
    "letter-spacing: 0.08em",
    "text-transform: uppercase",
    "padding: 9px 13px",
    "border: 0",
    "cursor: pointer",
    "text-align: left",
    ativo ? "background: var(--color-accent)" : "background: transparent",
    ativo ? "color: #fff" : "color: var(--color-text)",
  ].join(";");

// A métrica de cada obra vira uma linha só: citações · FWCI · momentum.
const metrica = (o: { cit?: string; fwci?: string; momentum?: string }) =>
  [o.cit, o.fwci, o.momentum].filter(Boolean).join(" · ");

// Procedência: trilha e tipo do estudo, sem repetir a sede que já vira etiqueta.
const procedencia = (o: { trilha: string; tipo: string }) =>
  [o.trilha, o.tipo].filter(Boolean).join(" · ");

// Etiqueta da sede. Sede revisada por pares recebe o acento; preprint fica em
// contorno, porque não passou por revisão.
const etiquetaSede = (sede: string, sobreAcento = false) => {
  const base =
    "font-family: var(--font-heading); font-weight: 800; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 8px; display: inline-block; white-space: nowrap; ";
  if (sede === "arXiv") {
    return (
      base +
      (sobreAcento
        ? "background: transparent; color: #fff; box-shadow: inset 0 0 0 2px rgba(255,255,255,0.6)"
        : "background: transparent; color: var(--color-text); box-shadow: inset 0 0 0 2px var(--color-divider)")
    );
  }
  return (
    base +
    (sobreAcento
      ? "background: #fff; color: var(--color-accent)"
      : "background: var(--color-accent); color: #fff")
  );
};

// Quantas indicações vieram de sede revisada por pares.
const comSede = [
  ...dados.tronco,
  ...dados.fases.flatMap((f) => [...f.secundarios, ...f.primarios]),
].filter((o) => o.sede !== "arXiv").length;

const totalObras =
  dados.tronco.length +
  dados.fases.reduce((s, f) => s + f.secundarios.length + f.primarios.length, 0);
---

<Base
  titulo="Base de leituras — Dev. de Software com IA"
  descricao="Ponto de partida de leitura extraído dos dois corpora: o tronco do campo e, para cada uma das onze fases do processo, os estudos secundários que dão o mapa e os trabalhos primários que mostram a prática."
>
  <article>
    <section class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 36px 32px 0">
      <a
        href={rota("/aulas/01")}
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase"
        >← Aula 01</a
      >
      <div
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700); margin-top: 28px"
      >
        Material da Aula 01 · Base de leituras
      </div>
      <h1
        style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(36px, 7vw, 76px); line-height: 0.96; letter-spacing: -0.035em; margin: 14px 0 0; max-width: 18ch; text-wrap: balance"
      >
        Por onde começar a ler
      </h1>
      <p style="font-size: 18px; line-height: 1.6; max-width: 64ch; margin: 24px 0 0; text-wrap: pretty">
        Ponto de partida extraído dos dois corpora do projeto: 233 estudos secundários e 321 artigos
        publicados em sedes de referência. Para cada uma das onze fases do processo, até dois estudos
        secundários — que dão o mapa da fase — e até dois trabalhos primários — que mostram como ela é
        praticada.
      </p>
      <p style="font-size: 16px; line-height: 1.6; max-width: 64ch; margin: 16px 0 0; opacity: 0.8; text-wrap: pretty">
        <strong>Isto não é um ranking de qualidade.</strong> O critério combina citações acumuladas,
        FWCI e aceleração recente, com peso maior para impacto acumulado. As métricas vêm do OpenAlex
        e faltam para boa parte dos preprints de 2025 e 2026, que ainda não têm indexação madura. Onde
        se lê <em>sem métrica indexada</em>, isso não significa pouco impacto — significa ausência de
        registro.
      </p>
      <div
        style="border: 2px solid var(--color-text); padding: 18px 20px; max-width: 64ch; margin: 24px 0 0; background: var(--color-neutral-100)"
      >
        <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700)">
          Recorte dos dados
        </div>
        <p style="font-size: 15px; line-height: 1.6; margin: 10px 0 0; text-wrap: pretty">
          Esta seleção sai do recorte de <strong>233 estudos secundários</strong>. As tabelas de
          distribuição por fase e ano, no <a href={rota("/codebook/mapeamento")}>mapeamento</a>, e as
          contagens do <a href={rota("/codebook")}>codebook</a> ainda são as de 171 — o último recorte
          com distribuição publicada. Por isso um número aqui pode não bater com um de lá; onde isso
          acontece, está dito.
        </p>
      </div>
      <div
        style="border: 2px solid var(--color-text); padding: 18px 20px; max-width: 64ch; margin: 20px 0 0; background: var(--color-neutral-100)"
      >
        <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700)">
          Onde cada trabalho saiu
        </div>
        <p style="font-size: 15px; line-height: 1.6; margin: 10px 0 0; text-wrap: pretty">
          Cada indicação abre com a sede de publicação. <span style={etiquetaSede("ICSE 2024")}
            >sede</span
          > em vermelho é conferência ou periódico revisado por pares — ICSE, FSE, ASE, ISSTA, MSR,
          ICSME, SANER, TSE, TOSEM. <span style={etiquetaSede("arXiv")}>arXiv</span> em contorno é
          preprint sem sede confirmada no corpus, o que vale para boa parte dos estudos secundários.
          Das {totalObras} indicações, {comSede} saíram em sede revisada por pares — inclusive
          <strong>todas as {dados.tronco.length} do tronco</strong>. Onde se lê <em>sede fora do corpus, a confirmar</em>,
          a sede foi preenchida a partir de registro externo e ainda não passou pela verificação do
          corpus.
        </p>
      </div>
      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 40px">
        <a class="btn btn-primary" href="#fases">Ir para as fases</a>
        <a class="btn btn-secondary" href={rota("/codebook")}>O codebook das fases</a>
      </div>
    </section>

    <!-- O tronco: os de maior impacto acumulado nos dois corpora somados. -->
    <section style="border-top: 2px solid var(--color-text); background: var(--color-accent); color: #fff">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 56px 32px">
        <h2
          style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(28px, 5vw, 52px); line-height: 1; letter-spacing: -0.03em; margin: 0; max-width: 24ch; text-wrap: balance"
        >
          Se a leitura precisar começar por seis artigos e nada mais
        </h2>
        <p style="font-size: 17px; line-height: 1.6; max-width: 62ch; margin: 18px 0 0">
          São as seis obras <strong>distintas</strong> com maior impacto acumulado nos dois corpora
          somados, e o vocabulário que elas fixaram é usado por quase todo o resto da literatura.
          Três aparecem nos dois corpora — são revisões publicadas em sede de referência — e estão
          contadas uma vez só. Cinco delas reaparecem adiante, na fase a que pertencem.
        </p>
        <div style="display: grid; gap: 0; margin-top: 36px; border-top: 2px solid rgba(255,255,255,0.45)">
          {
            dados.tronco.map((o, i) => (
              <div
                class="om-lab"
                style="display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 0 28px; padding: 22px 0; border-bottom: 2px solid rgba(255,255,255,0.45)"
              >
                <div style="font-family: var(--font-heading); font-weight: 900; font-size: 30px; line-height: 1; letter-spacing: -0.03em; opacity: 0.75">
                  {String(i + 1).padStart(2, "0")}
                </div>
                <div>
                  <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap; margin-bottom: 10px">
                    <span style={etiquetaSede(o.sede, true)}>{o.sede}</span>
                    <span style="font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85">
                      {procedencia(o)}
                    </span>
                  </div>
                  <a
                    href={o.url}
                    target="_blank"
                    rel="noopener"
                    style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(18px, 2.6vw, 23px); line-height: 1.2; letter-spacing: -0.015em; color: #fff; text-wrap: pretty"
                  >
                    {o.titulo}
                  </a>
                  <div style="font-size: 15px; line-height: 1.5; margin-top: 8px; opacity: 0.9">
                    {o.foco}
                  </div>
                  <div style="font-size: 13px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin-top: 10px; opacity: 0.8">
                    arXiv:{o.arxiv} · {metrica(o)}
                    {"notaSede" in o && o.notaSede ? ` · ${o.notaSede}` : ""}
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Índice: pular direto para a fase de interesse. -->
    <section id="fases" style="border-top: 2px solid var(--color-text)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(26px, 4vw, 40px); letter-spacing: -0.025em; margin: 0 0 8px">
          Por fase do processo
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 64ch; margin: 0 0 24px; text-wrap: pretty">
          A ordem segue o ciclo de vida: descoberta do problema, requisitos, arquitetura,
          implementação, verificação, reparo, manutenção, depois as fases de sustentação e as
          transversais. Ler na sequência dá a passagem de uma fase à seguinte — que é justamente o que
          o processo agêntico está reorganizando.
        </p>
        {/* As réguas saem de cada célula, não do fundo do container: com onze fases
            numa grade que se ajusta sozinha, sobram células e o fundo apareceria. */}
        <div
          style="display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0; border: 2px solid var(--color-text)"
        >
          {
            dados.fases.map((f) => (
              <a
                class="om-hover"
                href={`#${f.cod.toLowerCase()}`}
                style="background: var(--color-bg); padding: 14px 16px; display: block; color: var(--color-text); box-shadow: inset -2px -2px 0 var(--color-divider)"
              >
                <div style="font-family: var(--font-heading); font-weight: 800; font-size: 15px; line-height: 1.2; color: var(--color-accent)">
                  {f.curto}
                </div>
                <div style="font-size: 12px; margin-top: 4px; opacity: 0.7">
                  {f.secundarios.length + f.primarios.length} leituras
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    {
      dados.fases.map((f, iFase) => (
        <section
          id={f.cod.toLowerCase()}
          style={`border-top: 2px solid var(--color-text)${iFase % 2 === 1 ? "; background: var(--color-neutral-100)" : ""}`}
        >
          <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
            <h3 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(24px, 4vw, 34px); line-height: 1.1; letter-spacing: -0.03em; margin: 0; color: var(--color-accent); max-width: 26ch; text-wrap: balance">
              {f.nome}
            </h3>

            <div
              class="om-2col"
              style="display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; margin-top: 28px; align-items: start"
            >
              {[
                { rotulo: "Para entrar na fase", nota: "estudos secundários — o mapa", itens: f.secundarios },
                { rotulo: "Trabalho primário de referência", nota: "como a fase é praticada", itens: f.primarios },
              ].map((bloco) => (
                <div>
                  <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700)">
                    {bloco.rotulo}
                  </div>
                  <div style="font-size: 13px; opacity: 0.6; margin-top: 2px">{bloco.nota}</div>
                  <div style="border-top: 2px solid var(--color-text); margin-top: 12px">
                    {bloco.itens.map((o) => (
                      <div style="padding: 16px 0; border-bottom: 2px solid var(--color-divider)">
                        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap; margin-bottom: 8px">
                          <span style={etiquetaSede(o.sede)}>{o.sede}</span>
                          <span style="font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.55">
                            {procedencia(o)}
                          </span>
                        </div>
                        <a
                          href={o.url}
                          target="_blank"
                          rel="noopener"
                          style="font-family: var(--font-heading); font-weight: 700; font-size: 17px; line-height: 1.25; letter-spacing: -0.01em; text-wrap: pretty"
                        >
                          {o.titulo}
                        </a>
                        <div style="font-size: 15px; line-height: 1.5; margin-top: 6px; opacity: 0.85">
                          {o.foco}
                        </div>
                        <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 8px; opacity: 0.6">
                          arXiv:{o.arxiv} · {metrica(o)}
                          {"notaSede" in o && o.notaSede ? ` · ${o.notaSede}` : ""}
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </section>
      ))
    }

    <section id="corpus" style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 56px 32px">
        <div
          style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700)"
        >
          Corpus completo · navegável
        </div>
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(26px, 4vw, 40px); letter-spacing: -0.025em; margin: 10px 0 0">
          Os dois corpora, artigo por artigo
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 62ch; margin: 16px 0 28px; text-wrap: pretty">
          Acima está a seleção curada, com até quatro leituras por fase. Aqui está <strong
            >tudo</strong
          >: os dois corpora inteiros, artigo por artigo, com filtro por corpus e por fase. Cada
          registro traz autor, ano, foco declarado e o link para o arXiv.
        </p>
        <p style="font-size: 15px; line-height: 1.6; max-width: 64ch; margin: 0 0 28px; opacity: 0.8; text-wrap: pretty">
          <strong>Recorte desta lista.</strong> Ela vem dos CSV, que ainda são os de 157 estudos
          secundários e 106 artigos em sedes, sob oito fases. O corpus corrente é maior — 236 e 338,
          sob doze fases, como o <a href={rota("/codebook")}>codebook</a> registra —, e esta lista será
          trocada quando os CSV novos forem publicados.
        </p>

        <div style="display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start">
          <div id="corpus-abas" class="om-corpus-filtro" style="display: flex; border: 2px solid var(--color-text)">
            {
              abasCorpus.map((t, i) => (
                <button type="button" data-corpo={t.chave} style={estiloBotao(i === 0)}>
                  {t.label}
                </button>
              ))
            }
          </div>
          <div
            id="corpus-fases"
            class="om-corpus-filtro"
            style="display: flex; flex-wrap: wrap; border: 2px solid var(--color-text)"
          >
            {
              fasesCorpus.map((f, i) => (
                <button type="button" data-fase={f.chave} style={estiloBotao(i === 0)}>
                  {f.label}
                </button>
              ))
            }
          </div>
        </div>

        <div
          id="corpus-contagem"
          style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; margin: 20px 0 0"
        >
          Mostrando 0 de 0
        </div>

        <p id="corpus-vazio" style="font-size: 15px; opacity: 0.6; margin: 18px 0 0">
          Carregando o corpus…
        </p>

        <div id="corpus-lista" style="border-top: 2px solid var(--color-text); margin-top: 16px"></div>

        <div id="corpus-mais" style="margin-top: 24px; display: none">
          <button type="button" class="btn btn-secondary">Mostrar mais 50</button>
        </div>
      </div>
    </section>

    <section style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(24px, 4vw, 34px); letter-spacing: -0.025em; margin: 0 0 10px">
          Leituras de segurança
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 64ch; margin: 0 0 24px; text-wrap: pretty">
          Segurança não é uma fase do processo, é uma preocupação que o atravessa — por isso as obras
          dela não estão organizadas aqui, e sim numa página própria, agrupadas em dez tópicos e
          cruzadas com as doze fases. São 140 obras dos dois corpora, 77 com falha, vulnerabilidade
          ou ataque como objeto central.
        </p>
        <a class="btn btn-primary" href={rota("/seguranca#obras")}>Abrir as leituras de segurança</a>
      </div>
    </section>

    <section style="border-top: 2px solid var(--color-text)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 56px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(26px, 4vw, 40px); letter-spacing: -0.025em; margin: 0 0 10px">
          Como usar esta lista
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 62ch; margin: 0 0 28px; text-wrap: pretty">
          Três caminhos, dependendo do que você quer fazer com a leitura.
        </p>
        <div style="border-top: 2px solid var(--color-text)">
          {
            dados.caminhos.map((c) => (
              <div
                class="om-lab"
                style="display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 0 32px; padding: 22px 0; border-bottom: 2px solid var(--color-divider)"
              >
                <h3 style="font-family: var(--font-heading); font-weight: 800; font-size: 19px; line-height: 1.2; letter-spacing: -0.015em; margin: 0">
                  {c.titulo}
                </h3>
                <p style="font-size: 16px; line-height: 1.6; margin: 0; max-width: 64ch; text-wrap: pretty">
                  {c.texto}
                </p>
              </div>
            ))
          }
        </div>
        <p style="font-size: 15px; line-height: 1.6; max-width: 64ch; margin: 28px 0 0; opacity: 0.75; text-wrap: pretty">
          São {totalObras} indicações ao todo. Os corpora completos, com fase, tipo, métricas e
          momentum de cada obra, estão no <a href={rota("/codebook/mapeamento")}>mapeamento do campo</a
          >.
        </p>
        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px">
          <a class="btn btn-primary" href={rota("/aulas/01")}>Voltar para a Aula 01</a>
          <a class="btn btn-secondary" href={rota("/codebook/mapeamento")}>O mapeamento do campo</a>
        </div>
      </div>
    </section>
  </article>
</Base>

<script>
  // Navegador de corpus: única parte da página que depende de JavaScript.
  // Sem ele, tabelas, figuras e texto continuam legíveis.
  import { SECUNDARIOS, SEDES } from "../data/corpus.js";

  const AGENCIA: Record<string, string> = {
    alto: "Agentic central",
    medio: "Agentic em seção",
    baixo: "Sem foco em Agentic",
  };

  const lista = document.getElementById("corpus-lista")!;
  const contagem = document.getElementById("corpus-contagem")!;
  const vazio = document.getElementById("corpus-vazio")!;
  const mais = document.getElementById("corpus-mais")!;
  const abas = document.getElementById("corpus-abas")!;
  const filtrosFase = document.getElementById("corpus-fases")!;

  let corpo: "sec" | "sedes" = "sec";
  let fase = "Todas";
  let limite = 25;

  const pintar = (grupo: HTMLElement, atributo: string, valor: string) => {
    grupo.querySelectorAll<HTMLButtonElement>("button").forEach((b) => {
      const ligado = b.dataset[atributo] === valor;
      b.style.background = ligado ? "var(--color-accent)" : "transparent";
      b.style.color = ligado ? "#fff" : "var(--color-text)";
    });
  };

  const meta = (r: any) =>
    corpo === "sec"
      ? [r.tpn, AGENCIA[r.ag], r.cit ? `${r.cit} ${r.cit === "1" ? "citação" : "citações"}` : ""]
          .filter(Boolean)
          .join(" · ")
      : [
          `${r.sede} · ${r.trilha === "aceito" ? "trilha principal" : "workshop"}`,
          r.cn,
          AGENCIA[r.ag],
        ]
          .filter(Boolean)
          .join(" · ");

  const texto = (pai: HTMLElement, tag: string, estilo: string, conteudo: string) => {
    const el = document.createElement(tag);
    el.setAttribute("style", estilo);
    el.textContent = conteudo;
    pai.appendChild(el);
    return el;
  };

  const desenhar = () => {
    const base: any[] = corpo === "sec" ? SECUNDARIOS : SEDES;
    const filtrado = base.filter((r) => fase === "Todas" || r.f === fase);
    const mostrados = filtrado.slice(0, limite);

    lista.textContent = "";
    for (const r of mostrados) {
      const linha = document.createElement("div");
      linha.setAttribute(
        "style",
        "display: grid; grid-template-columns: minmax(0, 1fr); gap: 6px; padding: 18px 0; border-bottom: 2px solid var(--color-divider)"
      );

      const cabecalho = document.createElement("div");
      cabecalho.setAttribute("style", "display: flex; gap: 12px; flex-wrap: wrap; align-items: baseline");
      texto(
        cabecalho,
        "span",
        "font-family: var(--font-heading); font-weight: 900; font-size: 16px; color: var(--color-accent)",
        r.fn
      );
      texto(
        cabecalho,
        "span",
        "font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6",
        r.ano
      );
      linha.appendChild(cabecalho);

      const titulo = texto(
        linha,
        "a",
        "font-family: var(--font-heading); font-weight: 700; font-size: 18px; line-height: 1.3; letter-spacing: -0.01em; max-width: 74ch",
        r.t
      ) as HTMLAnchorElement;
      titulo.href = r.url;
      titulo.target = "_blank";
      titulo.rel = "noopener";

      texto(linha, "div", "font-size: 14px; line-height: 1.5; opacity: 0.8", `${r.a} · ${meta(r)}`);
      texto(linha, "div", "font-size: 14px; line-height: 1.5; max-width: 74ch", r.foco ?? "");

      lista.appendChild(linha);
    }

    contagem.textContent = `Mostrando ${mostrados.length} de ${filtrado.length}`;
    vazio.style.display = base.length === 0 ? "" : "none";
    mais.style.display = mostrados.length < filtrado.length ? "" : "none";
  };

  abas.addEventListener("click", (ev) => {
    const alvo = (ev.target as HTMLElement).closest("button");
    if (!alvo) return;
    corpo = alvo.dataset.corpo as "sec" | "sedes";
    limite = 25;
    pintar(abas, "corpo", corpo);
    desenhar();
  });

  filtrosFase.addEventListener("click", (ev) => {
    const alvo = (ev.target as HTMLElement).closest("button");
    if (!alvo) return;
    fase = alvo.dataset.fase!;
    limite = 25;
    pintar(filtrosFase, "fase", fase);
    desenhar();
  });

  mais.addEventListener("click", () => {
    limite += 50;
    desenhar();
  });

  desenhar();
</script>
