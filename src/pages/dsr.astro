---
import Base from "../layouts/Base.astro";
import { rota } from "../lib/url";
import dados from "../content/dsr.json";

const { abertura, template, secoes, referencias } = dados;

// Um bloco pode citar a obra que o fundamenta. Se o id não existir, o build para —
// melhor quebrar aqui do que publicar uma âncora que não leva a lugar nenhum.
const porId = new Map(referencias.map((r) => [r.id, r]));
for (const s of secoes)
  for (const b of s.blocos)
    if (b.ref && !porId.has(b.ref))
      throw new Error(`dsr.json: um bloco cita a referência "${b.ref}", que não existe`);

const ancora = (t: string) =>
  t
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");

// Texto corrido pede medida de leitura, não largura de página.
const leitura = "max-width: 34em;";
const paragrafo = `font-size: 17px; line-height: 1.72; margin: 0 0 18px; ${leitura} text-wrap: pretty;`;
const tituloSecao =
  "font-family: var(--font-heading); font-weight: 800; font-size: clamp(23px, 3.4vw, 31px); line-height: 1.14; letter-spacing: -0.022em; margin: 0; max-width: 22ch; text-wrap: balance";
---

<Base titulo={abertura.tituloPagina} descricao={abertura.descricao}>
  <article>
    <section class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 36px 32px 0">
      <a
        href={rota("/aulas/02")}
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase"
        >← Aula 02</a
      >
      <div
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700); margin-top: 28px"
      >
        Método · Design Science Research
      </div>
      <h1
        style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(32px, 6vw, 62px); line-height: 1; letter-spacing: -0.035em; margin: 14px 0 0; max-width: 18ch; text-wrap: balance"
      >
        {abertura.titulo}
      </h1>

      <p
        style={`font-size: 19px; line-height: 1.65; margin: 26px 0 34px; ${leitura} text-wrap: pretty`}
        set:html={abertura.intro}
      />
    </section>

    <section style="border-top: 2px solid var(--color-text)">
      <div class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 0 32px">
        <div class="om-guia">
          {/* Índice: acompanha a leitura no desktop, abre a página no celular */}
          <nav class="om-guia-indice">
            <div
              style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; padding: 22px 0 12px"
            >
              Neste guia
            </div>
            <ol style="list-style: none; padding: 0 0 22px; margin: 0; display: grid; gap: 9px">
              {
                secoes.map((s, i) => (
                  <li style="display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; align-items: baseline">
                    <span style="font-family: var(--font-heading); font-weight: 800; font-size: 12px; color: var(--color-accent)">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <a href={`#${ancora(s.titulo)}`} style="font-size: 14px; line-height: 1.3">
                      {s.titulo}
                    </a>
                  </li>
                ))
              }
              <li
                style="display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; align-items: baseline; padding-top: 8px; border-top: 2px solid var(--color-divider)"
              >
                <span style="font-size: 12px; opacity: 0.5">·</span>
                <a href="#template" style="font-size: 14px; line-height: 1.3">O template</a>
              </li>
              <li style="display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 8px; align-items: baseline">
                <span style="font-size: 12px; opacity: 0.5">·</span>
                <a href="#referencias" style="font-size: 14px; line-height: 1.3">Referências</a>
              </li>
            </ol>
          </nav>

          <div class="om-guia-texto">
            {
              secoes.map((s, i) => (
                <section id={ancora(s.titulo)} style="padding: 34px 0 6px; scroll-margin-top: 8px">
                  <div style="display: flex; gap: 14px; align-items: baseline; margin: 0 0 20px">
                    <span style="font-family: var(--font-heading); font-weight: 900; font-size: 15px; color: var(--color-accent); letter-spacing: 0.04em">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <h2 style={tituloSecao}>{s.titulo}</h2>
                  </div>

                  {s.blocos.map((b) =>
                    b.tipo === "citacao" ? (
                      <blockquote
                        style={`border-left: 2px solid var(--color-accent); margin: 4px 0 22px; padding: 2px 0 2px 22px; ${leitura}`}
                      >
                        <p
                          style="font-size: 17px; line-height: 1.65; margin: 0; font-style: italic"
                          set:html={b.texto}
                        />
                      </blockquote>
                    ) : b.tipo === "destaque" ? (
                      <p
                        style={`font-family: var(--font-heading); font-weight: 800; font-size: 19px; line-height: 1.42; letter-spacing: -0.015em; margin: 4px 0 24px; padding: 18px 22px; background: var(--color-neutral-100); ${leitura}`}
                        set:html={b.texto}
                      />
                    ) : (
                      <>
                        <p style={paragrafo} set:html={b.texto} />
                        {b.ref && (
                          <p style="margin: -10px 0 20px; font-size: 13px">
                            <a href={`#ref-${b.ref}`}>
                              {porId.get(b.ref)!.autores} ({porId.get(b.ref)!.ano})
                            </a>
                          </p>
                        )}
                      </>
                    )
                  )}
                </section>
              ))
            }

            <section id="template" style="padding: 34px 0 6px; scroll-margin-top: 8px">
              <h2 style={tituloSecao}>{template.titulo}</h2>
              <p style={`${paragrafo} margin-top: 20px`} set:html={template.texto} />
              <div style={`border: 2px solid var(--color-text); padding: 18px 22px; ${leitura} display: grid; gap: 14px`}>
                {
                  template.arquivos.map((a) => (
                    <div>
                      <a
                        href={rota(a.href)}
                        download
                        style="display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline"
                      >
                        <span style="font-family: var(--font-heading); font-weight: 800; font-size: 16px">
                          {a.nome}
                        </span>
                        <span style="font-size: 13px; opacity: 0.65; color: var(--color-text)">
                          {a.peso}
                        </span>
                      </a>
                      <p style="font-size: 14px; line-height: 1.5; margin: 3px 0 0; opacity: 0.8">
                        {a.descricao}
                      </p>
                    </div>
                  ))
                }
              </div>

              <div style={`border-left: 2px solid var(--color-accent); padding: 4px 0 4px 22px; margin: 26px 0 0; ${leitura}`}>
                <div style="font-family: var(--font-heading); font-weight: 800; font-size: 17px; letter-spacing: -0.015em">
                  {template.exemplo.titulo}
                </div>
                <p style="font-size: 16px; line-height: 1.62; margin: 8px 0 0">{template.exemplo.texto}</p>
                <a
                  href={template.exemplo.href}
                  style="display: inline-block; font-size: 15px; font-weight: 700; line-height: 1.35; margin: 10px 0 0"
                >
                  {template.exemplo.obra}
                </a>
                <p style="font-size: 13px; margin: 4px 0 0; opacity: 0.7">{template.exemplo.fonte}</p>
              </div>
            </section>

            <section id="referencias" style="padding: 34px 0 8px; scroll-margin-top: 8px">
              <h2 style={tituloSecao}>Referências</h2>
              <div style="border-top: 2px solid var(--color-text); margin-top: 20px">
                {
                  referencias.map((r) => (
                    <div
                      id={`ref-${r.id}`}
                      style={`padding: 16px 0; border-bottom: 2px solid var(--color-divider); scroll-margin-top: 8px; ${leitura}`}
                    >
                      <div style="font-family: var(--font-heading); font-weight: 800; font-size: 16px; line-height: 1.32">
                        {r.autores} ({r.ano}). {r.titulo}
                      </div>
                      <p style="font-size: 15px; line-height: 1.6; margin: 6px 0 0">{r.papel}</p>
                      <div style="display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 8px 0 0">
                        {r.enderecos.map((e) => (
                          <a href={e.href} style="font-size: 13px; font-weight: 700">
                            {e.rotulo} →
                          </a>
                        ))}
                      </div>
                    </div>
                  ))
                }
              </div>

              <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 32px 0 0">
                <a class="btn btn-secondary" href={rota("/aulas/02")}>Voltar para a Aula 02</a>
                <a class="btn btn-secondary" href={rota("/leituras")}>Base de leituras</a>
              </div>
            </section>
          </div>
        </div>
      </div>
    </section>
  </article>

  <style>
    /* Mobile: índice em cima, texto embaixo. */
    .om-guia {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
    }
    .om-guia-indice {
      border-bottom: 2px solid var(--color-divider);
    }
    @media (min-width: 861px) {
      /* Desktop: o índice acompanha a leitura. */
      .om-guia {
        grid-template-columns: 220px minmax(0, 1fr);
        gap: 0 56px;
        align-items: start;
      }
      .om-guia-indice {
        position: sticky;
        top: 76px;
        border-bottom: 0;
        border-right: 2px solid var(--color-divider);
        padding-right: 24px;
      }
    }
  </style>
</Base>
