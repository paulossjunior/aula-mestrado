---
import Base from "../layouts/Base.astro";
import { rota } from "../lib/url";
import dados from "../content/dsr.json";

const { abertura, template, partes, cadeia, referencias, fechamento } = dados;

// Uma parte pode citar a obra que a fundamenta. Se o id não existir, o build para —
// melhor quebrar aqui do que publicar uma âncora que não leva a lugar nenhum.
const porId = new Map(referencias.map((r) => [r.id, r]));
for (const p of partes) {
  if (p.referencia && !porId.has(p.referencia)) {
    throw new Error(`dsr.json: a parte ${p.n} cita a referência "${p.referencia}", que não existe`);
  }
}

const etiqueta =
  "font-family: var(--font-heading); font-weight: 800; font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; padding: 4px 8px; display: inline-block;";
---

<Base titulo={abertura.tituloPagina} descricao={abertura.descricao}>
  <article>
    <section class="om-pad" style="max-width: 1200px; margin: 0 auto; padding: 36px 32px 0">
      <a
        href={rota("/aulas/02")}
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase"
        >← Aula 02</a
      >
      <div
        style="font-size: 13px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-accent-700); margin-top: 28px"
      >
        Método · Design Science Research
      </div>
      <h1
        style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(36px, 7vw, 76px); line-height: 0.96; letter-spacing: -0.035em; margin: 14px 0 0; max-width: 20ch; text-wrap: balance"
      >
        {abertura.titulo}
      </h1>
      <p style="font-size: 18px; line-height: 1.6; max-width: 64ch; margin: 24px 0 0; text-wrap: pretty">
        {abertura.resumo}
      </p>

      <div
        style="border-left: 2px solid var(--color-accent); padding: 4px 0 4px 20px; margin: 28px 0 0; max-width: 66ch; display: grid; gap: 10px"
      >
        {
          abertura.chamada.map((frase, i) => (
            <p
              style={`margin: 0; line-height: 1.6; text-wrap: pretty; ${
                i === 0
                  ? "font-family: var(--font-heading); font-weight: 800; font-size: 19px; letter-spacing: -0.015em"
                  : "font-size: 16px"
              }`}
            >
              {frase}
            </p>
          ))
        }
      </div>

      <p style="font-size: 14px; line-height: 1.6; max-width: 64ch; margin: 24px 0 0; opacity: 0.7; text-wrap: pretty">
        {abertura.procedencia}
      </p>

      <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 28px 0 40px">
        <a class="btn btn-primary" href="#template">Baixar o template</a>
        <a class="btn btn-secondary" href="#partes">As nove partes</a>
        <a class="btn btn-secondary" href="#cadeia">A cadeia</a>
      </div>
    </section>

    {/* O template para download */}
    <section id="template" style="border-top: 2px solid var(--color-text); background: var(--color-neutral-100)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(24px, 4vw, 34px); letter-spacing: -0.025em; margin: 0 0 16px">
          O template
        </h2>
        <div style="border: 2px solid var(--color-text); padding: 20px 24px; max-width: 72ch; background: var(--color-bg)">
          <a
            href={rota(template.href)}
            download
            style="display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline"
          >
            <span style="font-family: var(--font-heading); font-weight: 800; font-size: 17px">
              {template.arquivo}
            </span>
            <span style="font-size: 13px; opacity: 0.65; color: var(--color-text)">
              {template.peso} · projeto LaTeX
            </span>
          </a>
          <p
            style="font-size: 15px; line-height: 1.6; margin: 14px 0 0; text-wrap: pretty"
            set:html={template.texto}
          />
          <ul style="list-style: none; padding: 0; margin: 16px 0 0; display: grid; gap: 6px">
            {
              template.conteudo.map((item) => (
                <li
                  style="font-size: 14px; line-height: 1.5; padding-left: 16px; position: relative"
                  set:html={`<span style="position: absolute; left: 0; color: var(--color-accent); font-weight: 800">·</span>${item}`}
                />
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    {/* As nove partes */}
    <section id="partes" style="border-top: 2px solid var(--color-text)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(26px, 4vw, 40px); letter-spacing: -0.025em; margin: 0 0 12px">
          O que escrever em cada parte
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 66ch; margin: 0 0 8px; text-wrap: pretty">
          Cada parte responde a uma pergunta. Se você não consegue dizer qual é a pergunta da seção
          que está escrevendo, ainda não é hora de escrevê-la.
        </p>

        <nav style="display: flex; flex-wrap: wrap; gap: 8px; margin: 24px 0 0">
          {
            partes.map((p) => (
              <a
                href={`#parte-${p.n}`}
                style="font-size: 13px; font-weight: 700; padding: 6px 10px; box-shadow: inset 0 0 0 2px var(--color-divider); text-decoration: none"
              >
                {p.n} {p.titulo}
              </a>
            ))
          }
        </nav>

        {
          partes.map((p) => (
            <div
              id={`parte-${p.n}`}
              style="border-top: 2px solid var(--color-text); padding: 28px 0 32px; scroll-margin-top: 8px"
            >
              <div class="om-2col" style="display: grid; grid-template-columns: 92px minmax(0, 1fr); gap: 0 28px">
                <div style="font-family: var(--font-heading); font-weight: 900; font-size: 40px; line-height: 1; color: var(--color-accent)">
                  {p.n}
                </div>
                <div style="min-width: 0">
                  <h3 style="font-family: var(--font-heading); font-weight: 800; font-size: clamp(20px, 3vw, 26px); line-height: 1.2; letter-spacing: -0.02em; margin: 0">
                    {p.titulo}
                  </h3>
                  <p style="font-size: 17px; line-height: 1.5; margin: 8px 0 0; font-style: italic; max-width: 62ch">
                    {p.pergunta}
                  </p>

                  <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6; margin: 22px 0 8px">
                    O que o texto precisa mostrar
                  </div>
                  <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: 10px">
                    {p.espera.map((e) => (
                      <li style="font-size: 16px; line-height: 1.6; padding-left: 18px; position: relative; max-width: 68ch; text-wrap: pretty">
                        <span style="position: absolute; left: 0; color: var(--color-accent); font-weight: 800">
                          ·
                        </span>
                        {e}
                      </li>
                    ))}
                  </ul>

                  {p.evitar.length > 0 && (
                    <div style="margin: 22px 0 0; box-shadow: inset 0 0 0 2px var(--color-divider); padding: 16px 20px; max-width: 68ch">
                      <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--color-accent-700)">
                        Evite
                      </div>
                      <ul style="list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 10px">
                        {p.evitar.map((e) => (
                          <li style="font-size: 15px; line-height: 1.6; text-wrap: pretty">{e}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {p.exemplo && (
                    <div style="margin: 18px 0 0; border-left: 2px solid var(--color-text); padding: 2px 0 2px 18px; max-width: 68ch">
                      <div style="font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; opacity: 0.6">
                        Exemplo
                      </div>
                      <p style="font-size: 15px; line-height: 1.6; margin: 8px 0 0; text-wrap: pretty">
                        {p.exemplo}
                      </p>
                    </div>
                  )}

                  {p.referencia && (
                    <p style="font-size: 13px; margin: 18px 0 0; opacity: 0.75">
                      Fundamento:{" "}
                      <a href={`#ref-${p.referencia}`}>
                        {porId.get(p.referencia)!.autores} ({porId.get(p.referencia)!.ano})
                      </a>
                    </p>
                  )}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </section>

    {/* A cadeia de autoverificação */}
    <section id="cadeia" style="border-top: 2px solid var(--color-text); background: var(--color-accent); color: #fff">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 56px 32px">
        <h2
          style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(26px, 4vw, 40px); line-height: 1.02; letter-spacing: -0.025em; margin: 0; max-width: 26ch; text-wrap: balance"
        >
          {fechamento.titulo}
        </h2>
        <p style="font-size: 17px; line-height: 1.6; max-width: 62ch; margin: 16px 0 0; text-wrap: pretty">
          {fechamento.texto}
        </p>

        <ol style="list-style: none; padding: 0; margin: 32px 0 0; border-top: 2px solid rgba(255,255,255,0.45)">
          {
            cadeia.map((c) => (
              <li
                id={`elo-${c.n}`}
                class="om-lab"
                style="display: grid; grid-template-columns: 44px minmax(0, 1fr); gap: 0 20px; padding: 14px 0; border-bottom: 2px solid rgba(255,255,255,0.45); scroll-margin-top: 8px"
              >
                <div style="font-family: var(--font-heading); font-weight: 900; font-size: 20px; opacity: 0.75">
                  {String(c.n).padStart(2, "0")}
                </div>
                <div style="min-width: 0">
                  <div style="font-family: var(--font-heading); font-weight: 800; font-size: 18px; line-height: 1.25; letter-spacing: -0.015em">
                    {c.elo}
                  </div>
                  <p style="font-size: 15px; line-height: 1.55; margin: 4px 0 0; opacity: 0.92; max-width: 64ch">
                    {c.pergunta}
                  </p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    {/* As quatro obras */}
    <section style="border-top: 2px solid var(--color-text)">
      <div class="om-pad om-sec" style="max-width: 1200px; margin: 0 auto; padding: 48px 32px">
        <h2 style="font-family: var(--font-heading); font-weight: 900; font-size: clamp(24px, 4vw, 34px); letter-spacing: -0.025em; margin: 0 0 12px">
          De onde vem o método
        </h2>
        <p style="font-size: 16px; line-height: 1.6; max-width: 66ch; margin: 0 0 28px; text-wrap: pretty">
          Quatro obras sustentam o template. Cada link abre um texto de acesso livre; a sede e o DOI
          ficam por escrito, para a referência continuar identificável se o endereço mudar.
        </p>
        <div style="border-top: 2px solid var(--color-text)">
          {
            referencias.map((r) => (
              <div id={`ref-${r.id}`} style="padding: 20px 0; border-bottom: 2px solid var(--color-divider); scroll-margin-top: 8px">
                <div style="display: flex; flex-wrap: wrap; gap: 8px; align-items: baseline">
                  <span style={`${etiqueta} background: var(--color-accent); color: #fff`}>
                    {r.ano}
                  </span>
                  <span style="font-family: var(--font-heading); font-weight: 800; font-size: 16px">
                    {r.autores}
                  </span>
                </div>
                <a
                  href={r.href}
                  style="display: inline-block; font-family: var(--font-heading); font-weight: 700; font-size: 17px; line-height: 1.3; letter-spacing: -0.01em; margin: 8px 0 0"
                >
                  {r.titulo}
                </a>
                <p style="font-size: 15px; line-height: 1.55; margin: 6px 0 0; max-width: 70ch; text-wrap: pretty">
                  {r.papel}
                </p>
                <p style="font-size: 13px; margin: 6px 0 0; opacity: 0.65">{r.registro}</p>
              </div>
            ))
          }
        </div>

        <div style="display: flex; gap: 12px; flex-wrap: wrap; margin: 36px 0 0">
          <a class="btn btn-secondary" href={rota("/aulas/02")}>Voltar para a Aula 02</a>
          <a class="btn btn-secondary" href={rota("/leituras")}>Base de leituras</a>
        </div>
      </div>
    </section>
  </article>
</Base>
